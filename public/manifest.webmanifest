{
  "name": "Pocket — Save for Later",
  "short_name": "Pocket",
  "description": "Save articles, videos, and pages to read later. Your personal reading list.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0A0A0F",
  "theme_color": "#EF4056",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/save",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "url": "url",
      "text": "text",
      "title": "title"
    }
  },
  "shortcuts": [
    {
      "name": "My List",
      "url": "/",
      "description": "View your saved articles"
    },
    {
      "name": "Favorites",
      "url": "/favorites",
      "description": "View your favorite articles"
    }
  ],
  "categories": ["productivity", "news", "books"]
}
