rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own user document
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Allow creating the profile doc (registration) — isPremium must not be true
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.get('isPremium', false) == false;

      // Allow updates but prevent users from granting themselves premium
      // (isPremium is set only by the lemonWebhook Cloud Function via admin SDK)
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.get('isPremium', false) == resource.data.get('isPremium', false);

      // Articles subcollection
      match /articles/{articleId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Highlights subcollection (premium feature)
        match /highlights/{highlightId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // Short links — any authenticated user can create; anyone can read (link preview crawlers)
    match /shares/{shareId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Global article stats — maintained by Cloud Function (admin SDK, bypasses rules)
    // Clients only need read access to show the featured article
    match /articleStats/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // only the Cloud Function writes here
    }

    // Support requests
    match /supportRequests/{requestId} {
      // Any authenticated user can create a request for themselves with status 'pending'
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';

      // Users can read their own requests; admin can read all
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || request.auth.token.email == 'sharansalian.business@gmail.com');

      // Admin can update status directly from the client (reject or done); approve goes via Cloud Function
      allow update: if request.auth != null
        && request.auth.token.email == 'sharansalian.business@gmail.com'
        && request.resource.data.status in ['rejected', 'done'];
      allow delete: if false;
    }
  }
}
