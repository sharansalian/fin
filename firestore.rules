rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Articles subcollection
      match /articles/{articleId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Featured articles — readable by any authenticated user, writable by admin only
    match /featured/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email == 'sharansalian.business@gmail.com';
    }

    // Support requests
    match /supportRequests/{requestId} {
      // Any authenticated user can create a request for themselves with status 'pending'
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';

      // Users can read their own requests; admin can read all
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || request.auth.token.email == 'sharansalian.business@gmail.com');

      // Admin can update status directly from the client (reject or done); approve goes via Cloud Function
      allow update: if request.auth != null
        && request.auth.token.email == 'sharansalian.business@gmail.com'
        && request.resource.data.status in ['rejected', 'done'];
      allow delete: if false;
    }
  }
}
